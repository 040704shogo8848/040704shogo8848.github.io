      <text x="360" y="76" font-size="13" font-weight="700" text-anchor="middle" style="fill:var(--warn)">言えない</text>
      <text x="590" y="76" font-size="13" font-weight="700" text-anchor="middle" style="fill:var(--warn)">言えない</text>
