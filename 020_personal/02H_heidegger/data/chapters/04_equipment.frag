        <text x="552" y="142" font-size="12" text-anchor="start" fill="var(--warm)">使用を控えて</text>
        <text x="552" y="160" font-size="12" text-anchor="start" fill="var(--warm)">眺める</text>
        <rect x="410" y="194" width="260" height="46" rx="6" fill="var(--card)" stroke="var(--pres)" stroke-width="1.6"/>
        <text x="540" y="222" font-size="13" text-anchor="middle" fill="var(--ink)">事物（事物的存在）が現れる</text>
      </svg>
