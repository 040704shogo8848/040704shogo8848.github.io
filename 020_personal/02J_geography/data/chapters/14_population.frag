<path d="M60,62 L230,62 C300,62 380,150 450,180 L560,190 L690,205" fill="none" stroke="var(--warm)" stroke-width="2.5"/>
<path d="M60,72 L120,70 C170,74 210,160 300,180 L560,188 L690,180" fill="none" stroke="var(--cool)" stroke-width="2.5"/>
