<thead><tr><th>比べる因子</th><th>地点 緯度 標高</th><th>年平均気温</th><th>年較差</th><th>年降水量</th></tr></thead>
<tbody>
<tr><td rowspan="2">海抜高度</td><td>コロンボ 北緯6.9度 7m</td><td>27.9℃</td><td>1.7℃</td><td>2,371mm</td></tr>
