        <rect x="560" y="132" width="150" height="56" rx="8" fill="var(--pres-soft)" stroke="var(--pres)" stroke-width="1.4"/>
        <text x="635" y="156" font-size="13" text-anchor="middle" fill="var(--ink)">行為の内容が</text>
        <text x="635" y="176" font-size="13" text-anchor="middle" fill="var(--ink)">明らかになる</text>
        <line x1="302" y1="160" x2="352" y2="160" stroke="var(--sub)" stroke-width="1.4" marker-end="url(#h09c)"/>
