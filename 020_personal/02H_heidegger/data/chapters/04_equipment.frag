        <text x="185" y="122" font-size="20" font-weight="700" text-anchor="middle" fill="var(--warn)">＋</text>
        <rect x="55" y="132" width="260" height="40" rx="6" fill="var(--card)" stroke="var(--warn)" stroke-width="1.6" stroke-dasharray="5 4"/>
        <text x="185" y="157" font-size="13" text-anchor="middle" fill="var(--ink)">「使える」という価値の述語</text>
        <line x1="185" y1="174" x2="185" y2="196" stroke="var(--sub)" stroke-width="1.6" marker-end="url(#h04d)"/>
        <rect x="55" y="200" width="260" height="40" rx="6" fill="var(--warn-soft)" stroke="var(--warn)" stroke-width="1.6"/>
