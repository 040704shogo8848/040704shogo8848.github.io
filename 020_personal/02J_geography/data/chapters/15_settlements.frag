<div class="tb-bar"><span>中国</span><u class="c"><i style="width:65.9%"></i></u><b>65.9%</b></div>
<div class="tb-bar"><span>世界</span><u class="c"><i style="width:57.6%"></i></u><b>57.6%</b></div>
